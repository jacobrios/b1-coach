# Copy this file to .env.local and fill in the real values. .env.local is
# gitignored; this template is committed on purpose, via the !.env.example
# negation in .gitignore. Do not remove that negation.

# Local development only. Vite proxies /api/coach straight to the Anthropic
# API, so the browser uses this key directly and api/coach.js never runs
# locally. See "Running it locally" in README.md.
VITE_ANTHROPIC_API_KEY=

# Production only. Set this in the Vercel dashboard, not in a file. The
# serverless function reads it server side and the browser never sees it.
ANTHROPIC_API_KEY=
